[Unit]
Description=Nagios Network Analyzer first-boot non-interactive install
After=network-online.target
Wants=network-online.target
ConditionPathExists=!/var/lib/nagiosna/.installed

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/nagiosna
ExecStart=/opt/nagiosna/fullinstall -n -f
ExecStartPost=/bin/mkdir -p /var/lib/nagiosna
ExecStartPost=/bin/touch /var/lib/nagiosna/.installed
# openssh-server is only installed so 15-chkconfigalldaemons (which
# unconditionally enables every daemon it finds) doesn't fail looking for
# sshd.service - nothing in this harness needs SSH access. Disable and stop
# it once fullinstall (and its chkconfig step) has already run.
ExecStartPost=/usr/bin/systemctl disable --now sshd.service
TimeoutStartSec=0
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

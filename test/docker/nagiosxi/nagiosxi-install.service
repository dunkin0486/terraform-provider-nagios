[Unit]
Description=Nagios XI first-boot non-interactive install
After=network-online.target
Wants=network-online.target
ConditionPathExists=!/var/lib/nagiosxi/.installed

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/nagiosxi
ExecStart=/opt/nagiosxi/fullinstall -n -f
ExecStartPost=/bin/mkdir -p /var/lib/nagiosxi
ExecStartPost=/bin/touch /var/lib/nagiosxi/.installed
# openssh-server is only installed so 15-chkconfigalldaemons (which
# unconditionally enables every daemon it finds) doesn't fail looking for
# sshd.service - nothing in this harness needs SSH access. Disable and stop
# it once fullinstall (and its chkconfig step) has already run.
ExecStartPost=/usr/bin/systemctl disable --now sshd.service
TimeoutStartSec=0
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
